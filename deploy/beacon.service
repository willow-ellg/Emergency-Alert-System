[Unit]
Description=Emergency Alert System thin beacon
Documentation=file:/opt/emergency-alert-system/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=emergency
Group=emergency
WorkingDirectory=/srv/emergency-snapshot
ExecStart=/opt/emergency-alert-system/bin/beacon serve \
  -dir /srv/emergency-snapshot \
  -addr :8081
Restart=on-failure
RestartSec=2s
ReadOnlyPaths=/srv/emergency-snapshot

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
